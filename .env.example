# Copy to .env for local development. Never commit real values.
# These names are a starting point; rename them to match your code.

AWS_REGION=us-east-1

# Set to "true" to serve pre-seeded demo events instead of live data
DEMO_MODE=true

# DynamoDB table names (created by the IaC stack)
EVENTS_TABLE_NAME=
FINDINGS_TABLE_NAME=

# Bedrock model used for plain-English explanations
BEDROCK_MODEL_ID=

# How to recognise the coding agent's identity in CloudTrail events
# (set after inspecting a real event; see docs/architecture.md)
AGENT_IDENTITY_MATCH=

# Days before stored events expire (keeps cost bounded)
EVENT_TTL_DAYS=14